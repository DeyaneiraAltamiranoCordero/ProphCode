<Window x:Class="ProphCode.IDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProphCode" Height="600" Width="1000"
        Background="#2D2F42" Foreground="#85868F">

    <!-- ===== Paleta y estilos ===== -->
    <Window.Resources>
        <!-- Colores base -->
        <SolidColorBrush x:Key="Bg"           Color="#2D2F42"/>
        <SolidColorBrush x:Key="Text"         Color="#85868F"/>
        <SolidColorBrush x:Key="Panel"        Color="#202330"/>
        <!-- editor y output -->
        <SolidColorBrush x:Key="Border"       Color="#3A3D55"/>
        <SolidColorBrush x:Key="Splitter"     Color="#3A3D55"/>
        <SolidColorBrush x:Key="Accent"       Color="#5965C9"/>
        <SolidColorBrush x:Key="AccentHover"  Color="#6B78D6"/>
        <SolidColorBrush x:Key="Selection"    Color="#31436F"/>

        <!-- Menu -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource Bg}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Bg}"/>
        </Style>

        <!-- Paneles / Bordes -->
        <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Splitter -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource Splitter}"/>
        </Style>

        <!-- TextBox: editor y consola -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Selection}"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <!-- Botón cuadrado con acento -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- cuadrado (CornerRadius=0) -->
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- ===== Layout ===== -->
    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="19*"/>
            <!-- menú -->
            <RowDefinition Height="557*"/>
            <!-- contenido -->
        </Grid.RowDefinitions>

        <!-- Menú -->
        <Menu Grid.Row="0" Grid.RowSpan="2">
            <MenuItem Header="_Archivo" Height="28" Foreground="#FFE6E6E6" BorderBrush="#FF212233">
                <MenuItem Header="_Nuevo"   InputGestureText="Ctrl+N" Click="Nuevo_Click"/>
                <MenuItem Header="_Guardar" InputGestureText="Ctrl+S" x:Name="mnuGuardar"/>
            </MenuItem>
            <MenuItem Header="_Opciones" Foreground="#FFD9D9D9" BorderBrush="#FF212233">
                <MenuItem Header="Palabras reservadas" x:Name="mnuPalabras"/>

                <MenuItem Header="Sintaxis">
                    <MenuItem Header="Control"     x:Name="mnuSintaxisControl"/>
                    <MenuItem Header="Funciones" x:Name="mnuSintaxisFunciones">
                        <MenuItem Header="Definir función" Click="InsertFunctionStructure"/>
                        <MenuItem Header="Función principal" Click="InsertMainFunctionStructure"/>
                        <MenuItem Header="Función sin retorno" Click="InsertFunctionWithoutReturn"/>
                    </MenuItem>
                    <MenuItem Header="Operaciones" x:Name="mnuSintaxisOperaciones">
                        <MenuItem Header="Aritméticos">
                            <MenuItem Header="Suma" Click="InsertAddition"/>
                            <MenuItem Header="Resta" Click="InsertSubtraction"/>
                            <MenuItem Header="Multiplicación" Click="InsertMultiplication"/>
                            <MenuItem Header="División" Click="InsertDivision"/>
                            <MenuItem Header="Módulo" Click="InsertModulo"/>
                        </MenuItem>
                        <MenuItem Header="Comparadores">
                            <MenuItem Header="Mayor" Click="InsertGreaterThan"/>
                            <MenuItem Header="Mayor o Igual" Click="InsertGreaterThanOrEqual"/>
                            <MenuItem Header="Menor" Click="InsertLessThan"/>
                            <MenuItem Header="Menor o Igual" Click="InsertLessThanOrEqual"/>
                        </MenuItem>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Tipos de datos">
                    <MenuItem Header="Simples" x:Name="mnuTiposSimples">
                        <MenuItem Header="Constante" Click="InsertProphecy"/>
                        <MenuItem Header="String" Click="InsertText"/>
                        <MenuItem Header="Intero" Click="InsertInt"/>
                        <MenuItem Header="Decimal" Click="InsertDec"/>
                        <MenuItem Header="Bolean" Click="InsertBool"/>
                        <MenuItem Header="Char" Click="InsertChar"/>
                    </MenuItem>
                    <MenuItem Header="Compuestos" x:Name="mnuTiposCompuestos">
                        <MenuItem Header="Lista" Click="InsertList"/>
                        <MenuItem Header="Vector" Click="InsertVec"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="E/S y Lógicas">
                    <MenuItem Header="Mostrar" Click="InsertReveal"/>
                    <MenuItem Header="Y lógico" Click="InsertAnd"/>
                    <MenuItem Header="O lógico" Click="InsertOr"/>
                    <MenuItem Header="No lógico" Click="InsertAnti"/>
                </MenuItem>
                <MenuItem Header="Literales">
                    <MenuItem Header="True" Click="InsertLiteralTrue"/>
                    <MenuItem Header="False" Click="InsertLiteralFalse"/>
                    <MenuItem Header="Null" Click="InsertLiteralNull"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Zona principal -->
        <Grid Grid.Row="2" Margin="10,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <!-- Editor -->
            <Border Grid.Column="0" Padding="8" Margin="0,-13,0,0">
                <TextBox x:Name="Editor"
                         AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="14"
                         TextWrapping="NoWrap"
                         Text=" " Foreground="#FFDADADA" TextChanged="Editor_TextChanged"/>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <!-- Panel derecho (OUTPUT + botones + consola) -->
            <Border Grid.Column="2" Padding="8">
                <DockPanel LastChildFill="True">
                    <!-- Encabezado output + botones a la derecha -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="OUTPUT" DockPanel.Dock="Left"
                                   FontWeight="SemiBold" Foreground="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="BtnCompilar" Content="COMPILAR"
                                    Style="{StaticResource AccentButton}"
                                    Click="BtnCompilar_Click"/>
                            <Button x:Name="BtnEjecutar" Content="EJECUTAR"
                                    Style="{StaticResource AccentButton}"
                                    Click="BtnEjecutar_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Consola -->
                    <TextBox x:Name="Consola"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13"
                             Text="Aquí aparecerán los mensajes de compilación, ejecución o errores..."/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
